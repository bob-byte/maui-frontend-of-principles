<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   x:Class="SET.MAUI.Views.PrivacyPolicyView"
                   xmlns:loc="clr-namespace:SET.MAUI.Resources.AppStrings"
                   xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                   xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:v="clr-namespace:SET.MAUI.Views"
                   xmlns:vm="clr-namespace:SET.MAUI.ViewModels"
                   xmlns:m="clr-namespace:SET.Core.Models;assembly=SET.Core"
                   xmlns:templates="clr-namespace:SET.MAUI.Views.Templates"
                   xmlns:controls="clr-namespace:SET.MAUI.Controls"
                   x:DataType="vm:PrivacyPolicyViewModel"
                   Title="{x:Static loc:LocStrings.PrivacyPolicy}">
    <ScrollView>
        <VerticalStackLayout Margin="20,20,20,20">
            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyIntroduction}"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="Start" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyInformationCollectionandUseTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyInformationCollectionandUseText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyLogDataTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyLogDataText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicySecurityTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicySecurityText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyChildrensPrivacyTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyChildrensPrivacyText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyChangesTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyChangesText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyContactInfoTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.PrivacyPolicyContactInfoText}"
                   HorizontalOptions="FillAndExpand" />
        </VerticalStackLayout>
    </ScrollView>
</v:ContentPageBase>