<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   x:Class="SET.MAUI.Views.EditHabitView"
                   xmlns:loc="clr-namespace:SET.MAUI.Resources.AppStrings"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                   xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:v="clr-namespace:SET.MAUI.Views"
                   xmlns:vm="clr-namespace:SET.MAUI.ViewModels"
                   xmlns:m="clr-namespace:SET.Core.Models;assembly=SET.Core"
                   x:DataType="vm:EditHabitViewModel"
                   x:Name="CPB_EditHabit"
                   Shell.TabBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding BackCommand}" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto, *, Auto"
              x:Name="G_Title">
            <Label Text="{Binding NameOfHabit.Value}"
                   x:Name="L_TitleText"
                   VerticalOptions="Center"
                   TextColor="{StaticResource TitleTextColor}"
                   FontAttributes="Bold"
                   LineBreakMode="TailTruncation"
                   FontSize="17"
                   Grid.Column="0" />
            <Grid x:Name="G_SaveHabit"
                  HorizontalOptions="End"
                  VerticalOptions="CenterAndExpand"
                  SizeChanged="G_SaveHabit_SizeChanged"
                  Grid.Column="2">
                <dxco:SimpleButton Text="{Binding LocSave,
                                                  Converter={StaticResource ToUpperCase}}"
                                   Style="{StaticResource TitlePrimaryButton}"
                                   x:Name="SB_SaveHabit"
                                   Clicked="SB_Save_Clicked"
                                   Margin="{OnPlatform iOS='0,2,0,2',
                                                       Android='0, 2, 5, 0'}"
                                   FontSize="12"
                                   BorderThickness="2" />
            </Grid>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <dxco:TabView HeaderPanelPosition="Top"
                      x:Name="TV_Tabs"
                      ItemHeaderTextColor="{StaticResource LightPlaceholderColor}"
                      SelectedItemHeaderTextColor="{StaticResource LightNormalText}"
                      IsVisible="{Binding IsLoadingHabitInfo,
                                          Converter={StaticResource IsFalse}}"
                      SwipeEnabled="True"
                      BackgroundColor="White"
                      HeaderPanelBackgroundColor="White"
                      SelectedItemHeaderBackgroundColor="White">
            <dxco:TabViewItem HeaderText="{x:Static loc:LocStrings.Data}"
                              HeaderIconPosition="{OnPlatform iOS='Right'}"
                              HeaderTextColor="{StaticResource LightPlaceholderColor}"
                              SelectedHeaderTextColor="{StaticResource LightNormalText}"
                              HeaderWidth="160">
                <ScrollView>
                    <VerticalStackLayout Padding="10"
                                         Spacing="6">
                        <dxe:AutoCompleteTokenEdit LabelText="{x:Static loc:LocStrings.AreasOfHabit}"
                                                   EndIcon="dotshorizontal"
                                                   ItemsSource="{Binding AllUserAreasOfLife}"
                                                   EndIconClicked="TE_AreasOfLife_EndIconClicked"
                                                   Tap="TE_AreasOfLife_Tap"
                                                   StartIcon="rule"
                                                   IsStartIconVisible="True"
                                                   DisplayMember="Name"
                                                   SelectedItems="{Binding Habit.AreasOfLife,
                                                                           Mode=TwoWay}"
                                                   SelectionChanged="TE_AreasOfLife_SelectionChanged"
                                                   DropDownSelectedItemBackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary},
                                                                                                         Dark={StaticResource LightPrimary}}"
                                                   x:Name="TE_AreasOfLife"
                                                   TextChanged="TE_AreasOfLife_TextChanged">
                            <dxe:AutoCompleteTokenEdit.TokenAppearance>
                                <dxe:TokenAppearance BorderColor="{StaticResource Primary}"
                                                     BorderThickness="2.5"
                                                     CornerRadius="14"
                                                     FontSize="14"
                                                     TextColor="{AppThemeBinding Light={StaticResource LightNormalText},
                                                                                 Dark={StaticResource DarkNormalText}}"
                                                     PressedBorderColor="{StaticResource Primary}" />
                            </dxe:AutoCompleteTokenEdit.TokenAppearance>
                        </dxe:AutoCompleteTokenEdit>
                        <dxe:MultilineEdit Text="{Binding NameOfHabit.Value}"
                                           LabelText="{x:Static loc:LocStrings.Name}"
                                           HasError="{Binding NameOfHabit.IsValid,
                                                              Converter={StaticResource IsFalse}}"
                                           IsErrorIconVisible="True"
                                           x:Name="ME_NameOfHabit"
                                           MaxLineCount="5"
                                           StartIcon="fire_first"
                                           ReturnType="Done"
                                           ClearIconVisibility="Never"
                                           Margin="0,0,0,-10" />
                        <dxe:ChoiceChipGroup x:Name="CCG_Types"
                                             HorizontalOptions="CenterAndExpand"
                                             IsMultiline="True"
                                             Margin="0,0,0,-10">
                            <dxe:Chip Text="{x:Static loc:LocStrings.WithoutExceptions}"
                                      Icon="info"
                                      x:Name="C_WithoutExceptionsType"
                                      TapCommand="{Binding TapWithoutExceptionsTypeCommand,
                                                           Source={RelativeSource AncestorType={x:Type vm:EditHabitViewModel}}}"
                                      TapCommandParameter="{x:Reference C_WithoutExceptionsType}">
                            </dxe:Chip>
                            <dxe:Chip Text="{x:Static loc:LocStrings.IntegrallyWise}"
                                      Icon="info"
                                      x:Name="C_IntegrallyWiseType"
                                      TapCommand="{Binding TapIntegrallyWiseTypeCommand,
                                                           Source={RelativeSource AncestorType={x:Type vm:EditHabitViewModel}}}"
                                      TapCommandParameter="{x:Reference C_IntegrallyWiseType}" />
                        </dxe:ChoiceChipGroup>
                        <dxe:TextEdit x:Name="TE_Frequency"
                                      Text="{Binding FrequencyRepresentation}"
                                      LabelText="{x:Static loc:LocStrings.Frequency}"
                                      IsReadOnly="True"
                                      StartIcon="restart"
                                      StartIconClicked="FrequencyIcon_Clicked"
                                      EndIcon="dotshorizontal"
                                      EndIconClicked="FrequencyIcon_Clicked"
                                      Tap="TE_Frequency_Tap" />
                        <dxe:NumericEdit Value="{Binding Habit.Priority}"
                                         LabelText="{x:Static loc:LocStrings.Priority}"
                                         MinValue="1"
                                         AllowLooping="True"
                                         AllowAnimation="True"
                                         ValueChangedCommand="{Binding ReorderUserHabitsCommand}"
                                         MaxValue="{Binding UserHabits.Count,
                                                            Mode=OneTime}"
                                         StartIcon="priority"
                                         EndIcon="dotshorizontal"
                                         x:Name="NE_Priority"
                                         EndIconClicked="NE_Priority_EndIconClicked" />
                        <dxe:NumericEdit Value="{Binding Habit.Complexity}"
                                         LabelText="{x:Static loc:LocStrings.ComplexityWithRange}"
                                         MinValue="1"
                                         MaxDecimalDigitCount="0"
                                         MaxValue="10"
                                         HelpText="{Binding ComplexityHelpText}"
                                         IsEnabled="{Binding IsNewHabit}"
                                         StartIcon="charts"
                                         IsUpDownIconVisible="True" />
                        <dxco:SimpleButton Text="{x:Static loc:LocStrings.RecommendedHabitsButton}"
                                           Style="{StaticResource PrimaryButton}"
                                           Clicked="SB_RecomendedHabit_Clicked" />
                        <dxco:BottomSheet x:Name="BS_AllHabits">
                            <Grid RowDefinitions="Auto, Auto"
                                  RowSpacing="20"
                                  Padding="0,7,0,15">
                                <Label Style="{StaticResource CentralHeader}"
                                       LineBreakMode="WordWrap"
                                       HorizontalTextAlignment="Center"
                                       HorizontalOptions="CenterAndExpand"
                                       Text="{x:Static loc:LocStrings.SetPriorityByDragAndDrop}"
                                       Grid.Row="0" />

                                <dxcv:DXCollectionView AllowDragDropItems="True"
                                                       ZIndex="100"
                                                       ItemsSource="{Binding UserHabits}"
                                                       x:Name="DXC_SelectPriority"
                                                       Grid.Row="1">
                                    <dxcv:DXCollectionView.Behaviors>
                                        <toolkit:EventToCommandBehavior EventName="CompleteItemDragDrop"
                                                                        Command="{Binding ResetPrioritiesCommand}" />
                                    </dxcv:DXCollectionView.Behaviors>
                                    <dxcv:DXCollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="m:UserHabit">
                                            <Grid RowDefinitions="Auto, Auto"
                                                  ColumnDefinitions="*, 30"
                                                  ColumnSpacing="15">
                                                <Label Text="{Binding Name}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"
                                                       Padding="10,15,0,0"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="End"
                                                       VerticalTextAlignment="End"
                                                       Grid.Row="0"
                                                       Grid.Column="0" />
                                                <Grid Margin="0,0,5,0"
                                                      Padding="0"
                                                      RowSpacing="0"
                                                      ColumnSpacing="0"
                                                      Grid.Column="1">
                                                    <Frame BackgroundColor="{StaticResource LightPrimary}"
                                                           Margin="0"
                                                           Padding="0"
                                                           WidthRequest="30"
                                                           HeightRequest="30"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Center"
                                                           HasShadow="False"
                                                           CornerRadius="15"
                                                           IsClippedToBounds="True">
                                                        <Label Text="{Binding Priority}"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center" />
                                                    </Frame>
                                                </Grid>
                                                <BoxView Grid.Row="1"
                                                         Style="{StaticResource DefaultHorizonalSeparator}"
                                                         Grid.Column="0"
                                                         Grid.ColumnSpan="2" />
                                            </Grid>
                                        </DataTemplate>
                                    </dxcv:DXCollectionView.ItemTemplate>
                                </dxcv:DXCollectionView>
                            </Grid>
                        </dxco:BottomSheet>
                        <dxco:DXPopup x:Name="DXP_Errors"
                                      AllowScrim="True"
                                      AllowAnimation="True"
                                      AllowShadow="True"
                                      CloseOnScrimTap="True"
                                      MinimumWidthRequest="230"
                                      HeightRequest="200">
                            <dx:DXStackLayout Orientation="Vertical">
                                <Label Text="{x:Static loc:LocStrings.FixErrorsFirst}"
                                       Style="{StaticResource CentralHeader}"
                                       Margin="10,10,10,0" />
                                <dx:DXStackLayout Margin="15"
                                                  Orientation="Horizontal"
                                                  ItemSpacing="10"
                                                  x:Name="HSL_ErrorMessages">
                                    <dx:DXImage Source="info"
                                                x:Name="DXI_Error"
                                                WidthRequest="25"
                                                HeightRequest="25"
                                                TintColor="{StaticResource Error}"
                                                VerticalOptions="Center" />
                                    <dx:DXStackLayout Orientation="Vertical"
                                                      x:Name="DXS_ErrorMessages"
                                                      ItemSpacing="7"
                                                      VerticalOptions="Center" />
                                </dx:DXStackLayout>
                                <dxco:SimpleButton x:Name="SB_CloseErrorsPopup"
                                                   Clicked="SB_CloseErrorsPopup_Clicked"
                                                   Text="{x:Static loc:LocStrings.OK}"
                                                   FontSize="16"
                                                   HorizontalOptions="End"
                                                   MinimumWidthRequest="60"
                                                   Margin="0,5,5,5"
                                                   Style="{StaticResource PrimaryButton}" />
                            </dx:DXStackLayout>
                        </dxco:DXPopup>
                        <dxco:DXPopup x:Name="DXP_Frequency"
                                      AllowScrim="True"
                                      AllowAnimation="True"
                                      MinimumWidthRequest="250"
                                      AllowShadow="True"
                                      CloseOnScrimTap="True">
                            <VerticalStackLayout Margin="15"
                                                 Spacing="0">
                                <dxe:CheckEdit Label="{x:Static loc:LocStrings.EveryDay}"
                                               x:Name="CE_EveryDay"
                                               CheckedCheckBoxImage="checkedcheckedit"
                                               UncheckedCheckBoxImage="uncheckedcheckedit"
                                               CheckedChanged="OnCheckEditChangedInFrequencyPopup"
                                               DisabledCheckedCheckBoxColor="{StaticResource Primary}"
                                               DisabledLabelColor="{AppThemeBinding Light={StaticResource LightNormalText},
                                                                                    Dark={StaticResource DarkNormalText}}" />
                                <HorizontalStackLayout Margin="{OnPlatform iOS='0, 10, 0, 10', Android='0, 5, 0, 0'}">
                                    <dxe:CheckEdit x:Name="CE_EverySeveralDays"
                                                   CheckedChanged="OnCheckEditChangedInFrequencyPopup"
                                                   Label="{x:Static loc:LocStrings.Every}"
                                                   CheckedCheckBoxImage="checkedcheckedit"
                                                   UncheckedCheckBoxImage="uncheckedcheckedit"
                                                   DisabledCheckedCheckBoxColor="{StaticResource Primary}"
                                                   DisabledLabelColor="{AppThemeBinding Light={StaticResource LightNormalText},
                                                                                        Dark={StaticResource DarkNormalText}}" />
                                    <dxe:TextEdit Keyboard="Numeric"
                                                  Margin="{OnPlatform iOS='6,0,0,5',
                                                                      Android='3,5,0,5'}"
                                                  x:Name="TE_RepeatsOfSeveralDays"
                                                  Focused="RepeatsOfSeveralDays_Focused"
                                                  HeightRequest="30"
                                                  BoxMinWidth="30"
                                                  BoxPadding="6,5,5,5"
                                                  ClearIconVisibility="Never"
                                                  TextChanged="TE_RepeatsOfSeveralDays_TextChanged"
                                                  TextHorizontalAlignment="Center"
                                                  BackgroundColor="{AppThemeBinding Light={StaticResource Background},
                                                                                    Dark={StaticResource DarkBackground}}" />
                                    <Label Text="{x:Static loc:LocStrings.days}"
                                           FontSize="16"
                                           Margin="{OnPlatform iOS='7, 6, 0, 0',
                                                               Android='3, 8, 0, 0'}"
                                           Focused="RepeatsOfSeveralDays_Focused">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="EverySeveralDaysFrequency_Tapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout>
                                    <dxe:CheckEdit x:Name="CE_SeveralTimesPerPeriod"
                                                   CheckedCheckBoxImage="checkedcheckedit"
                                                   UncheckedCheckBoxImage="uncheckedcheckedit"
                                                   CheckedChanged="OnCheckEditChangedInFrequencyPopup"
                                                   DisabledCheckedCheckBoxColor="{StaticResource Primary}"
                                                   DisabledLabelColor="{AppThemeBinding Light={StaticResource LightNormalText},
                                                                                        Dark={StaticResource DarkNormalText}}"
                                                   Margin="{OnPlatform iOS='0, 0, 0, 15'}" />
                                    <dxe:TextEdit Keyboard="Numeric"
                                                  Margin="{OnPlatform iOS='0, 0, 0, 15',
                                                                      Android='9, 8, 0, 5'}"
                                                  TextHorizontalAlignment="Center"
                                                  HeightRequest="30"
                                                  BoxMinWidth="30"
                                                  BoxPadding="6,5,5,5"
                                                  ClearIconVisibility="Never"
                                                  x:Name="TE_RepeatsOfSeveralTimesPerPeriod"
                                                  Focused="SeveralTimesPerPeriodFrequency_Focused"
                                                  TextChanged="TE_RepeatsOfSeveralTimesPerPeriod_TextChanged"
                                                  BackgroundColor="{AppThemeBinding Light={StaticResource Background},
                                                                                    Dark={StaticResource DarkBackground}}" />
                                    <Label Text="{x:Static loc:LocStrings.timesPer}"
                                           FontSize="16"
                                           Margin="{OnPlatform iOS='7, 10, 0, 0',
                                                               Android='3, 10, 3, 0'}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="SeveralTimesPerPeriodFrequency_Tapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <dxe:ComboBoxEdit x:Name="CBE_Period"
                                                      ItemsSource="{Binding PeriodsOfHabit}"
                                                      SelectedItem="{Binding SelectedPeriodOfHabit}"
                                                      DisplayMember="Name"
                                                      WidthRequest="100"
                                                      HeightRequest="37"
                                                      BoxPadding="10, 10, 0, 10"
                                                      IsDropDownIconVisible="False"
                                                      Tap="CBE_Period_Tap"
                                                      Focused="SeveralTimesPerPeriodFrequency_Focused"
                                                      Margin="{OnPlatform iOS='7, 0, 0, 15',
                                                                          Android='0, 3, 0, 0'}"
                                                      BackgroundColor="{AppThemeBinding Light={StaticResource Background},
                                                                                        Dark={StaticResource DarkBackground}}" />
                                </HorizontalStackLayout>
                                <dxco:SimpleButton x:Name="SB_SaveFrequencyPopup"
                                                   Clicked="SB_SaveFrequencyPopup_Clicked"
                                                   Text="{Binding LocSave}"
                                                   HorizontalOptions="End"
                                                   FontSize="16"
                                                   Margin="0,10,0,0"
                                                   Style="{StaticResource PrimaryButton}" />
                            </VerticalStackLayout>
                        </dxco:DXPopup>

                        <dxco:BottomSheet x:Name="BS_RecommendedHabits"
                                          BackgroundColor="{AppThemeBinding Light={StaticResource Background},
                                                                            Dark={StaticResource DarkBackground}}"
                                          ShowGrabber="True"
                                          AllowDismiss="True"
                                          HalfExpandedRatio="0.6">
                            <Grid>
                                <VerticalStackLayout Padding="0,7,0,15"
                                                     Spacing="20"
                                                     VerticalOptions="CenterAndExpand">
                                    <Label Text="{x:Static loc:LocStrings.RecommendedHabitsByAi}"
                                           Style="{StaticResource CentralHeader}" />

                                    <dxcv:DXCollectionView ItemsSource="{Binding RecommendedHabits}"
                                                           x:Name="DXC_RecommendedHabits"
                                                           Margin="0,0,0,0">
                                        <dxcv:DXCollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="m:RecommendedHabit">
                                                <Grid RowDefinitions="Auto, Auto"
                                                      ColumnDefinitions="140, *"
                                                      ColumnSpacing="15">
                                                    <Label Text="{Binding Name}"
                                                           Padding="10,15,0,0"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="End"
                                                           VerticalTextAlignment="End"
                                                           Grid.Row="0"
                                                           Grid.Column="0">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="TGR_RecommendedHabit_Tapped"
                                                                                  x:Name="TGR_RecommendedHabit"
                                                                                  CommandParameter="{Binding}"
                                                                                  NumberOfTapsRequired="1" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <Label Text="{Binding ReasonToFollow}"
                                                           ToolTipProperties.Text="{Binding ReasonToFollow}"
                                                           LineBreakMode="TailTruncation"
                                                           VerticalOptions="End"
                                                           VerticalTextAlignment="Center"
                                                           MaxLines="4"
                                                           Margin="0,0,5,0"
                                                           Grid.Row="0"
                                                           Grid.Column="1">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="TGR_RecommendedHabit_Tapped"
                                                                                  CommandParameter="{Binding}"
                                                                                  NumberOfTapsRequired="1" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <BoxView Grid.Row="1"
                                                             Style="{StaticResource DefaultHorizonalSeparator}"
                                                             Grid.Column="0"
                                                             Grid.ColumnSpan="2" />
                                                </Grid>
                                            </DataTemplate>
                                        </dxcv:DXCollectionView.ItemTemplate>
                                    </dxcv:DXCollectionView>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="0">
                                    <skia:SKLottieView IsVisible="{Binding IsBusy}"
                                                       RepeatCount="-1"
                                                       Source="fire_loading.json"
                                                       HorizontalOptions="Center"
                                                       WidthRequest="105"
                                                       HeightRequest="105" />
                                    <Label Text="{x:Static loc:LocStrings.Loading}"
                                           IsVisible="{Binding IsBusy}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{x:Static loc:LocStrings.IfYouDontWantToWaitYouCanChangeOtherFields}"
                                           IsVisible="{Binding IsBusy}"
                                           HorizontalTextAlignment="Center"
                                           WidthRequest="270"
                                           HeightRequest="100"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="4" />
                                </VerticalStackLayout>
                            </Grid>
                        </dxco:BottomSheet>
                    </VerticalStackLayout>
                </ScrollView>
            </dxco:TabViewItem>
            <dxco:TabViewItem HeaderText="{x:Static loc:LocStrings.HowToKeep}"
                              HeaderTextColor="{StaticResource LightPlaceholderColor}"
                              SelectedHeaderTextColor="{StaticResource LightNormalText}"
                              HeaderIconPosition="{OnPlatform iOS='Right'}"
                              HeaderWidth="160">
                <ScrollView>
                    <VerticalStackLayout Padding="10"
                                         Spacing="6">
                        <dxe:MultilineEdit Text="{Binding ReasonToFollow.Value}"
                                           x:Name="ME_ReasonToFollow"
                                           LabelText="{x:Static loc:LocStrings.StrongReasonToFollow}"
                                           HasError="{Binding ReasonToFollow.IsValid,
                                                              Converter={StaticResource IsFalse}}"
                                           IsErrorIconVisible="False"
                                           StartIcon="approved"
                                           EndIcon="info"
                                           EndIconCommand="{Binding ShowSnackbarForReasonToFollowCommand}"
                                           EndIconCommandParameter="{x:Reference ME_ReasonToFollow}"
                                           ClearIconVisibility="Never" />
                        <dxe:MultilineEdit Text="{Binding Habit.Question}"
                                           x:Name="TE_Habit"
                                           LabelText="{x:Static loc:LocStrings.Question}"
                                           StartIcon="question"
                                           ClearIconVisibility="Never"
                                           EndIcon="info"
                                           EndIconCommand="{Binding ShowSnackbarForQuestionCommand}"
                                           EndIconCommandParameter="{x:Reference TE_Habit}" />
                        <dxe:MultilineEdit Text="{Binding Habit.Description}"
                                           LabelText="{x:Static loc:LocStrings.NotesOrHowToKeepHabit}"
                                           ClearIconVisibility="Never"
                                           StartIcon="notes" />
                    </VerticalStackLayout>
                </ScrollView>
            </dxco:TabViewItem>
        </dxco:TabView>

        <VerticalStackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="0">
            <skia:SKLottieView IsVisible="{Binding IsLoadingHabitInfo}"
                               RepeatCount="-1"
                               Source="fire_loading.json"
                               HorizontalOptions="Center"
                               WidthRequest="150"
                               HeightRequest="150" />
            <Label Text="{x:Static loc:LocStrings.LoadingContent}"
                   IsVisible="{Binding IsLoadingHabitInfo}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</v:ContentPageBase>
