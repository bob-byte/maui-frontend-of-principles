<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   x:Class="SET.MAUI.Views.SettingsView"
                   xmlns:loc="clr-namespace:SET.MAUI.Resources.AppStrings"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:dxg="clr-namespace:DevExpress.Maui.DataGrid;assembly=DevExpress.Maui.DataGrid"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:templates="clr-namespace:SET.MAUI.Views.Templates"
                   xmlns:v="clr-namespace:SET.MAUI.Views"
                   xmlns:vm="clr-namespace:SET.MAUI.ViewModels"
                   xmlns:m="clr-namespace:SET.Core.Models;assembly=SET.Core"
                   x:DataType="vm:SettingsViewModel"
                   Title="{Binding Title}">
    <Grid>
        <VerticalStackLayout Padding="15,0,15,0"
                             VerticalOptions="Center">
            <Image Source="logolargesize"
                   WidthRequest="200"
                   HeightRequest="200" />
            <Label Text="{Binding AppName,
                                  Converter={StaticResource ToUpperCase}}"
                   TextColor="OrangeRed"
                   HorizontalOptions="Center"
                   FontSize="Title"
                   FontFamily="Roboto"
                   FontAttributes="Bold" />

            <Label Text="{x:Static loc:LocStrings.ContactInfoText}"
                   FontSize="12"
                   TextColor="{StaticResource LightNormalText}"
                   HorizontalTextAlignment="Start"
                   Margin="0,15,0,0" />

            <dxco:SimpleButton Command="{Binding OpenEmailCommand}"
                               Text="{x:Static loc:LocStrings.ContactEmail}"
                               x:Name="SB_ContactInfo"
                               Style="{StaticResource PrimaryButton}"
                               Margin="0,5,0,0" />

            <dxco:SimpleButton Text="{x:Static loc:LocStrings.PrivacyPolicy}"
                               Command="{Binding ShowPrivacyPolicyCommand}"
                               x:Name="SB_PrivacyPolicy"
                               Style="{StaticResource PrimaryButton}"
                               Margin="0,15,0,0" />
            <dxco:SimpleButton Text="{x:Static loc:LocStrings.UserAgreement}"
                               Command="{Binding ShowUserAgreementCommand}"
                               x:Name="SB_UserAgreement"
                               Style="{StaticResource PrimaryButton}"
                               Margin="0,15,0,0" />
            <dxco:SimpleButton Command="{Binding LogoutCommand}"
                               Text="{x:Static loc:LocStrings.Logout}"
                               Style="{StaticResource SecondaryButton}"
                               Margin="0,15,0,0" />
            <dxco:SimpleButton Command="{Binding DeleteAccountCommand}"
                               Text="{x:Static loc:LocStrings.DeleteAccount}"
                               Style="{StaticResource SecondaryButton}"
                               Margin="0,15,0,0" />
        </VerticalStackLayout>

        <templates:DefaultActivityIndicator />
    </Grid>
</v:ContentPageBase>