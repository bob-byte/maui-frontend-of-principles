# Copy to Principles/.env for Debug/Release (gitignored).
# For LocalDebug, also copy to Principles/.env.Development with local/dev keys.
# Values are embedded into the app at build time when the matching file exists.
# CI/Release hosts can set the same names as process environment variables instead.
# Quote values that contain #, &, ;, or other shell-sensitive characters.

ENCRYPTION_FIRST_KEY="CHANGE_ME"
ENCRYPTION_SECOND_KEY="CHANGE_ME"
API_KEY_ENCRYPTION_FIRST_KEY="CHANGE_ME"
API_KEY_ENCRYPTION_SECOND_KEY="CHANGE_ME"
GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
