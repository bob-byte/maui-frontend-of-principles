{
  "AttributesTolerance": 1,
  "KeepFirstAttributeOnSameLine": true,
  "MaxAttributeCharactersPerLine": 80,
  "MaxAttributesPerLine": 1,
  "NewlineExemptionElements": "",
  "AttributeIndentation": 0,
  "AttributeIndentationStyle": 1,
  "RemoveDesignTimeReferences": false,
  "EnableAttributeReordering": true,
  "AttributeOrderingRuleGroups": [
    "x:Class",
    "xmlns, xmlns:x",
    "xmlns:*", "x:Key, Key, x:Name, Name, x:Uid, Uid, Title",
    "Label, LabelText, Caption, Placeholder",
    "Header",
    "Text",
    "Expression",
    "Property, SortProperty, DisplayProperty, ItemsProperty",
    "Value, CheckedValue, IsChecked",
    "Content",
    "ItemsSource",
    "Delegate, SetDelegate",
    "Source",
    "Command, DoubleClick, Clicked",
    "Role",
    "XamlStyle, Style",
    "If, Show, Hide, IsVisible, Disabled, Required",
    "Sort, DataType",
    "Icon, IconHorizontalPosition",
    "Rows, Columns",
    "Width, WidthRequest, Height, HeightRequest, MinWidth, MinHeight, MaxWidth, MaxHeight",
    "Direction, Orientation, Margin, Padding, HorizontalAlignment, VerticalAlignment, HorizontalContentAlignment, VerticalContentAlignment, Panel.ZIndex",
    "*:*, *",
    "PageSource, PageIndex, Offset, Color, TargetName, StartPoint, EndPoint",
    "mc:Ignorable, d:IsDataSource, d:LayoutOverrides, d:IsStaticText",
    "Storyboard.*, From, To, Duration, Grid.Row, Grid.RowSpan, Grid.Col, Grid.Column, Grid.ColSpan, Grid.ColumnSpan, Canvas.Left, Canvas.Top, Canvas.Right, Canvas.Bottom"
  ],
  "FirstLineAttributes": "",
  "OrderAttributesByName": true,
  "PutEndingBracketOnNewLine": false,
  "RemoveEndingTagOfEmptyElement": true,
  "SpaceBeforeClosingSlash": true,
  "RootElementLineBreakRule": 0,
  "ReorderVSM": 2,
  "ReorderGridChildren": false,
  "ReorderCanvasChildren": false,
  "ReorderSetters": 0,
  "FormatMarkupExtension": true,
  "NoNewLineMarkupExtensions": "",
  "ThicknessSeparator": 2,
  "ThicknessAttributes": "Margin, Padding, Thickness",
  "FormatOnSave": true,
  "SaveAndCloseOnFormat": false,
  "CommentPadding": 2,
  "SearchToDriveRoot": true
}