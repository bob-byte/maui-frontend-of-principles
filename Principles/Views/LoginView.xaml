<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:loc="clr-namespace:Principles.Resources.AppStrings"
                   xmlns:vm="clr-namespace:Principles.ViewModels"
                   xmlns:v="clr-namespace:Principles.Views"
                   xmlns:templates="clr-namespace:Principles.Views.Templates"
                   x:Class="Principles.Views.LoginView"
                   x:DataType="vm:LoginViewModel"
                   Shell.FlyoutBehavior="Disabled"
                   Shell.NavBarIsVisible="True"
                   Shell.TabBarIsVisible="False"
                   Title="{Binding Title}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="15"
                                 Spacing="0"
                                 VerticalOptions="CenterAndExpand">
                <Image Source="logolargesize"
                       WidthRequest="200"
                       HeightRequest="200" />
                <Label Text="{Binding AppName, 
                                  Converter={StaticResource ToUpperCase}}"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       FontSize="30"
                       FontFamily="Roboto"
                       FontAttributes="Bold" />
                <dxe:TextEdit Text="{Binding Email.Value}"
                              LabelText="{x:Static loc:LocStrings.Email}"
                              AutofillContentType="EmailAddress"
                              StartIcon="email"
                              Keyboard="Email"
                              ClearIconVisibility="Never"
                              HasError="{Binding Email.IsValid,
                                                 Converter={StaticResource IsFalse}}"
                              ErrorText="{Binding Email.Errors,
                                                  Converter={StaticResource FirstValidationError}}"
                              TextChangedCommand="{Binding ValidateEmailCommand}"
                              ReserveBottomTextLine="True"
                              Margin="0,10,0,0" />
                <dxe:PasswordEdit Text="{Binding Password.Value}"
                                  x:Name="PasswordEntry"
                                  LabelText="{x:Static loc:LocStrings.Password}"
                                  StartIcon="password"
                                  AutofillContentType="Password"
                                  HasError="{Binding Password.IsValid,
                                                     Converter={StaticResource IsFalse}}"
                                  ErrorText="{Binding Password.Errors,
                                                      Converter={StaticResource FirstValidationError}}"
                                  TextChangedCommand="{Binding ValidatePasswordCommand}"
                                  ReserveBottomTextLine="True" />

                <dxco:SimpleButton Text="{x:Static loc:LocStrings.Login}"
                                   Command="{Binding LoginCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,5,0,0" />
                <dxco:SimpleButton Text="{x:Static loc:LocStrings.SignUp}"
                                   Command="{Binding SignupCommand}"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource DarkPrimary},
                                                                     Dark={StaticResource Primary}}"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                               Dark={StaticResource DarkPrimary}}"
                                   Margin="0,15,0,0" />

                <Grid VerticalOptions="Start"
                      RowDefinitions="Auto, Auto, Auto"
                      RowSpacing="5"
                      Margin="0,25,0,0">
                    <Label HorizontalTextAlignment="End"
                           Text="{x:Static loc:LocStrings.ForgetPasswordNavigation}"
                           TextColor="{StaticResource LightNormalText}"
                           FontSize="{OnPlatform Android=12,
                                                 iOS=14}"
                           FontFamily="MonaSansMedium"
                           Grid.Row="0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenForgetPasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{x:Static loc:LocStrings.LoginAgreementText}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           TextColor="Gray"
                           FontSize="12"
                           FontFamily="MonaSansMedium"
                           FontAttributes="Italic"
                           Margin="0,15,0,0"
                           HorizontalTextAlignment="Center"
                           Grid.Row="1" />
                    <Label HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           Grid.Row="2">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static loc:LocStrings.UserAgreementStrInLoginAndSignupViews}"
                                      TextColor="{StaticResource LightNormalText}"
                                      FontSize="12"
                                      FontFamily="MonaSansMedium"
                                      FontAttributes="Italic">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenUserAgreementCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text=" "/>
                                <Span Text="{x:Static loc:LocStrings.LoginSignUpAgreementСonnectingText}"
                                      TextColor="Gray"
                                      FontSize="12"
                                      FontFamily="MonaSansMedium"
                                      FontAttributes="Italic" />
                                <Span Text=" "/>
                                <Span Text="{x:Static loc:LocStrings.PrivacyPolicyStrInLoginAndSignupViews}"
                                      TextColor="{StaticResource LightNormalText}"
                                      FontSize="12"
                                      FontFamily="MonaSansMedium"
                                      FontAttributes="Italic">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator Color="{StaticResource Primary}"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           WidthRequest="100" />
    </Grid>
</v:ContentPageBase>