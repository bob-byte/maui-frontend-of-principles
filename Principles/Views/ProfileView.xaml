<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase x:Class="Principles.Views.ProfileView"
                       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                       xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                       xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
                       xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                       xmlns:loc="clr-namespace:Principles.Resources.AppStrings"
                       xmlns:views="clr-namespace:Principles.Views"
                       xmlns:vm="clr-namespace:Principles.ViewModels"
                       xmlns:models="clr-namespace:Principles.Core.Models;assembly=Principles.Core"
                       xmlns:templates="clr-namespace:Principles.Views.Templates"
                       x:DataType="vm:ProfileViewModel">
    <Shell.TitleView>
        <Grid VerticalOptions="CenterAndExpand"
              Margin="0,0,5,0"
              ColumnDefinitions="Auto, *, Auto">
            <Label Text="{Binding Title}"
                   VerticalOptions="Center"
                   VerticalTextAlignment="Center"
                   HorizontalOptions="Start"
                   TextColor="{StaticResource TitleTextColor}"
                   FontSize="20"
                   FontAttributes="Bold"
                   HeightRequest="50"
                   Grid.Column="0" />
            <dx:DXImage Source="settings"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        TintColor="{StaticResource TitleTextColor}"
                        Margin="65,0,0,0"
                        WidthRequest="40"
                        HeightRequest="40"
                        Grid.Column="2">
                <dx:DXImage.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                          Command="{Binding GoToSettingsCommand}" />
                </dx:DXImage.GestureRecognizers>
            </dx:DXImage>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="10,0,10,0">

            <Grid ColumnSpacing="10"
                  x:Name="G_UserIcon">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,0,0"
                      Padding="0"
                      RowSpacing="0"
                      ColumnSpacing="0"
                      Grid.Column="0">
                    <Frame BackgroundColor="{StaticResource DarkEditControlBackColor}"
                           Margin="0"
                           Padding="0"
                           WidthRequest="48"
                           HeightRequest="48"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           IsClippedToBounds="True"
                           HasShadow="False"
                           CornerRadius="24">
                        <Image Source="{Binding Gender, Converter={StaticResource GenderToIcon}}" />
                    </Frame>

                    <Ellipse Fill="Transparent"
                             Stroke="White"
                             StrokeThickness="2"
                             WidthRequest="50"
                             HeightRequest="50"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />
                </Grid>

                <dxe:TextEdit Text="{Binding UserName.Value}"
                              LabelText="{x:Static loc:LocStrings.UserName}"
                              x:Name="TE_UserName"
                              ClearIconVisibility="Never"
                              IsReadOnly="True"
                              EndIcon="check_third"
                              EndIconColor="{StaticResource Primary}"
                              IsEndIconVisible="{Binding UserName.IsValid}"
                              ErrorColor="{StaticResource Error}"
                              TextChangedCommand="{Binding ValidateUserNameCommand}"
                              HasError="{Binding UserName.IsValid,
                                                 Converter={StaticResource IsFalse}}"
                              ErrorText="{Binding UserName.Errors,
                                                  Converter={StaticResource FirstValidationError}}"
                              Margin="0,2"
                              Grid.Column="1"
                              Focused="TRG_UserName_Focused" />
            </Grid>

            <dxe:MultilineEdit Text="{Binding MainSlogan}"
                               LabelText="{x:Static loc:LocStrings.MainSlogan}"
                               x:Name="ME_MainSlogan"
                               ClearIconVisibility="Never"
                               IsReadOnly="True"
                               EndIcon="info"
                               EndIconColor="{StaticResource Primary}"
                               EndIconCommand="{Binding ShowSnackbarForMainSloganCommand}"
                               Margin="0,2"
                               Focused="TGR_MainSlogan_Focused" />

            <dxe:MultilineEdit Text="{Binding Mission}"
                               LabelText="{x:Static loc:LocStrings.Mission}"
                               x:Name="ME_Mision"
                               ClearIconVisibility="Never"
                               IsReadOnly="True"
                               EndIcon="info"
                               EndIconColor="{StaticResource Primary}"
                               EndIconCommand="{Binding ShowSnackbarForMissionCommand}"
                               Margin="0,2"
                               Focused="TGR_Mission_Focused" />

            <dxco:DXPopup x:Name="DXP_Prompt"
                          AllowAnimation="True"
                          AllowScrim="True"
                          AllowShadow="True"
                          CloseOnScrimTap="True"
                          MinimumWidthRequest="300">
                <VerticalStackLayout>
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="5">
                        <Label x:Name="L_Prompt"
                               Style="{StaticResource CentralHeader}" />
                    </HorizontalStackLayout>
                    <dxe:MultilineEdit x:Name="ME_PromptResult"
                                       ClearIconVisibility="Never"
                                       Margin="10"
                                       TextFontSize="16"
                                       EndIcon="info"
                                       EndIconClicked="EI_Tip_Clicked"
                                       EndIconColor="{StaticResource Primary}"
                                       IconVerticalAlignment="Center" />
                    <HorizontalStackLayout HorizontalOptions="End">
                        <dxco:SimpleButton x:Name="SB_Cancel"
                                           BackgroundColor="{StaticResource CancelButtonColor}"
                                           Text="{x:Static loc:LocStrings.Cancel}"
                                           FontSize="16"
                                           Margin="0,0,5,5"
                                           Icon="close"
                                           IconHorizontalPosition="Left"
                                           Clicked="SB_Cancel_Clicked" />
                        <dxco:SimpleButton x:Name="SB_Save"
                                           Style="{StaticResource PrimaryButton}"
                                           Text="{Binding LocSave}"
                                           FontSize="16"
                                           Margin="0,0,5,5"
                                           IconHorizontalPosition="Left"
                                           Icon="check_second"
                                           Clicked="SB_Save_Clicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </dxco:DXPopup>


            <dxco:DXPopup x:Name="DXP_Tip"
                          AllowAnimation="True"
                          AllowScrim="True"
                          AllowShadow="True"
                          CloseOnScrimTap="True"
                          MinimumWidthRequest="200"
                          VerticalOptions="End"
                          VerticalAlignment="Bottom"
                          CornerRadius="5"
                          BackgroundColor="{StaticResource LightPrimary}">

                <Grid ColumnDefinitions="85*, 15*">
                    <Label x:Name="L_TipText"
                           Padding="10"
                           Grid.Column="0"
                           VerticalOptions="Center"
                           TextColor="Black" />
                    <Button Text="{x:Static loc:LocStrings.OK}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            Grid.Column="1"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="B_Ok_Clicked" />
                </Grid>
            </dxco:DXPopup>

            <templates:DefaultActivityIndicator />
        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>