<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   x:Class="Principles.Views.UserAgreementView"
                   xmlns:loc="clr-namespace:Principles.Resources.AppStrings"
                   xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                   xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:v="clr-namespace:Principles.Views"
                   xmlns:vm="clr-namespace:Principles.ViewModels"
                   xmlns:m="clr-namespace:Principles.Core.Models;assembly=Principles.Core"
                   xmlns:templates="clr-namespace:Principles.Views.Templates"
                   xmlns:controls="clr-namespace:Principles.Controls"
                   x:DataType="vm:UserAgreementViewModel"
                   Title="{x:Static loc:LocStrings.UserAgreementTitle}">
    <ScrollView>
        <VerticalStackLayout Margin="20, 20, 20, 20">
            <Label Text="{x:Static loc:LocStrings.UserAgreementIntroduction}"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="Start" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementAcceptanceofTermsTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementAcceptanceofTermsText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementRightsandResponsibilitiesOfUserTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementRightsandResponsibilitiesOfUserText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementRightsandResponsibilitiesofPrinciplesTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementRightsandResponsibilitiesofPrinciplesText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementIntellectualPropertyTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementIntellectualPropertyText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementDisclaimerofWarrantiesTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementDisclaimerofWarrantiesText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementLimitationofLiabilityTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementLimitationofLiabilityText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementLicenseTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementLicenseText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementPersonalDataTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementPersonalDataText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementSeverabilityTitle}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementSeverabilityText}"
                   HorizontalOptions="FillAndExpand" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementLastUpdate}"
                   HorizontalOptions="FillAndExpand"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Label Text="{x:Static loc:LocStrings.UserAgreementContactInformation}"
                   HorizontalOptions="FillAndExpand"
                   Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</v:ContentPageBase>
