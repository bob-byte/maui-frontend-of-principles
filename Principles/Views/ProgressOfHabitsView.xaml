<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                   xmlns:dxg="clr-namespace:DevExpress.Maui.DataGrid;assembly=DevExpress.Maui.DataGrid"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
                   xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:vm="clr-namespace:Principles.ViewModels"
                   xmlns:v="clr-namespace:Principles.Views"
                   xmlns:m="clr-namespace:Principles.Core.Models;assembly=Principles.Core"
                   xmlns:loc="clr-namespace:Principles.Resources.AppStrings"
                   xmlns:controls="clr-namespace:Principles.Controls"
                   IconImageSource="fire_third.svg"
                   xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                   x:DataType="vm:ProgressOfHabitsViewModel"
                   x:Class="Principles.Views.ProgressOfHabitsView"
                   Shell.NavBarIsVisible="True">
    <Shell.TitleView>
        <Grid VerticalOptions="CenterAndExpand"
              ColumnDefinitions="Auto, 0, Auto, *, Auto, 10, Auto"
              Margin="0,0,5,0">
            <dx:DXImage Source="fire_seventh"
                        TintColor="{StaticResource DarkIconColor}"
                        WidthRequest="30"
                        HeightRequest="30"
                        Grid.Column="0" />
            <Label Text="{x:Static loc:LocStrings.MyHabits}"
                   VerticalOptions="Center"
                   VerticalTextAlignment="Center"
                   HorizontalOptions="Start"
                   TextColor="{StaticResource TitleTextColor}"
                   FontSize="20"
                   FontAttributes="Bold"
                   HeightRequest="50"
                   Grid.Column="2" />

            <dx:DXImage Source="reminder"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        TintColor="{StaticResource TitleTextColor}"
                        WidthRequest="35"
                        HeightRequest="35"
                        Grid.Column="5">
                <dx:DXImage.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                          Tapped="DXI_Reminder_Tapped"
                                          Command="{Binding SetReminderReportCommand}" />
                </dx:DXImage.GestureRecognizers>
            </dx:DXImage>


            <dx:DXImage Source="plus"
                        IsVisible="{Binding SelectedHabit,
                                            Converter={StaticResource IsNull}}"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        TintColor="{StaticResource TitleTextColor}"
                        Margin="15,0,0,0"
                        WidthRequest="40"
                        HeightRequest="40"
                        Grid.Column="6">
                <dx:DXImage.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                          Command="{Binding AddHabitCommand}" />
                </dx:DXImage.GestureRecognizers>
            </dx:DXImage>
            <dx:DXImage Source="edit"
                        TintColor="{StaticResource TitleTextColor}"
                        Margin="35,0,0,0"
                        HorizontalOptions="End"
                        WidthRequest="40"
                        VerticalOptions="Center"
                        IsVisible="{Binding SelectedHabit,
                                            Converter={StaticResource IsNotNull}}"
                        HeightRequest="30"
                        Grid.Column="4">
                <dx:DXImage.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                          Command="{Binding EditHabitCommand}"
                                          CommandParameter="{Binding SelectedHabit}" />
                </dx:DXImage.GestureRecognizers>
            </dx:DXImage>
            <dx:DXImage Source="delete"
                        TintColor="{StaticResource TitleTextColor}"
                        Margin="3,0,0,0"
                        HorizontalOptions="End"
                        WidthRequest="40"
                        VerticalOptions="Center"
                        IsVisible="{Binding SelectedHabit,
                                            Converter={StaticResource IsNotNull}}"
                        HeightRequest="30"
                        Grid.Column="6">
                <dx:DXImage.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                          Command="{Binding DeleteHabitCommand}"
                                          CommandParameter="{Binding SelectedHabit}" />
                </dx:DXImage.GestureRecognizers>
            </dx:DXImage>
        </Grid>
    </Shell.TitleView>

    <Grid BackgroundColor="{StaticResource Background}">
        <dxg:DataGridView ItemsSource="{Binding UserHabits}"
                          SelectedItem="{Binding SelectedHabit}"
                          AllowDragDropRows="False"
                          x:Name="DGV_Habits"
                          RowLongPressCommand="{OnPlatform iOS={Binding SelectRowCommand}}"
                          AllowInitiallySelectedRow="False"
                          BackgroundColor="{StaticResource Background}"
                          AllowSort="False"
                          AllowVirtualHorizontalScrolling="True"
                          VerticalLineThickness="0"
                          IsHorizontalScrollBarVisible="False"
                          IsLoadMoreEnabled="False"
                          FullSwipeMode="Start"
                          AllowLiveDataShaping="True"
                          CustomSort="DGV_Habits_SortByGoalName">
            <dxg:DataGridView.ColumnHeaderAppearance>
                <dxg:ColumnHeaderAppearance BackgroundColor="#f7f2f7" />
            </dxg:DataGridView.ColumnHeaderAppearance>
            <dxg:DataGridView.GroupRowAppearance>
                <dxg:GroupRowAppearance BackgroundColor="#f7f2f7" />
            </dxg:DataGridView.GroupRowAppearance>

            <dxg:DataGridView.StartSwipeItems>
                <dxg:SwipeItem Command="{Binding DeleteHabitCommand}"
                               BackgroundColor="{StaticResource RedColor}"
                               Caption="{x:Static loc:LocStrings.Delete}" />
            </dxg:DataGridView.StartSwipeItems>

            <dxg:DataGridView.SwipeItemAppearance>
                <dxg:SwipeItemAppearance Width="125" />
            </dxg:DataGridView.SwipeItemAppearance>

            <dxg:DataGridView.Columns>
                <!--  {} in GroupCaptionDisplayFormat means display Goal.Name without a caption  -->
                <dxg:TextColumn FieldName="Goal.Name"
                                IsGrouped="True"
                                GroupInterval="DisplayText"
                                GroupCaptionDisplayFormat="{}{1}"
                                SortMode="Custom">
                    <dxg:TextColumn.GroupCaptionTemplate>
                        <DataTemplate x:DataType="dxg:GroupRowData">
                            <Label Text="{Binding GroupValueText}"
                                   FontSize="15" />
                        </DataTemplate>
                    </dxg:TextColumn.GroupCaptionTemplate>
                </dxg:TextColumn>
            </dxg:DataGridView.Columns>

            <dxg:DataGridView.CellAppearance>
                <dxg:CellAppearance SelectionColor="{StaticResource TertiaryLight}"
                                    BackgroundColor="{StaticResource Background}" />
            </dxg:DataGridView.CellAppearance>
        </dxg:DataGridView>

        <dx:DXStackLayout Orientation="Vertical"
                          ItemSpacing="10"
                          HorizontalOptions="CenterAndExpand"
                          VerticalOptions="Start"
                          IsVisible="{Binding UserHabits.Count,
                                              Converter={StaticResource IsZero}}">
            <skia:SKLottieView IsAnimationEnabled="True"
                               RepeatCount="-1"
                               WidthRequest="300"
                               HeightRequest="250"
                               Margin="0,150,0,0"
                               Source="checks.json" />
            <Label Text="{x:Static loc:LocStrings.LoadingContent}"
                   IsVisible="{Binding IsBusy}"
                   FontFamily="MonaSansMedium"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource LightNormalText},
                                               Dark={StaticResource DarkNormalText}}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{x:Static loc:LocStrings.HabitCollectionIsEmptyDescription}"
                   IsVisible="{Binding IsBusy,
                                       Converter={StaticResource IsFalse}}"
                   FontFamily="MonaSansMedium"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource LightNormalText},
                                               Dark={StaticResource DarkNormalText}}"
                   HorizontalTextAlignment="Center" />
        </dx:DXStackLayout>

        <dxco:DXPopup x:Name="DXP_Reminder"
                      AllowAnimation="True"
                      AllowScrim="True"
                      AllowShadow="True"
                      CloseOnScrimTap="True"
                      MinimumWidthRequest="300">
            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static loc:LocStrings.Reminder}"
                       Style="{StaticResource CentralHeader}" />


                <dxe:MultilineEdit Text="{Binding ReminderReport.Title}"
                                   LabelText="{x:Static loc:LocStrings.ReminderTitle}"
                                   MaxLineCount="2"
                                   StartIcon="remindertitle"
                                   ClearIconVisibility="Never"
                                   MaximumWidthRequest="285" />

                <dxe:MultilineEdit Text="{Binding ReminderReport.Description}"
                                   LabelText="{x:Static loc:LocStrings.ReminderDescription}"
                                   MaxLineCount="3"
                                   StartIcon="reminderdescription"
                                   ClearIconVisibility="Never"
                                   MaximumWidthRequest="285" />

                <dxe:TimeEdit LabelText="{x:Static loc:LocStrings.Time}"
                              StartIcon="clock"
                              Time="{Binding ReminderReport.Time}"
                              MaximumWidthRequest="285" />

                <HorizontalStackLayout HorizontalOptions="Start">
                    <Switch IsToggled="{Binding ReminderReport.IsEnabled}" />
                    <Label Text="{x:Static loc:LocStrings.Enable}"
                           VerticalOptions="Center"
                           Margin="3,0,0,0"
                           TextColor="{StaticResource LightNormalText}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="End"
                                       Padding="0">
                    <dxco:SimpleButton x:Name="SB_ReminderReport_Cancel"
                                       BackgroundColor="{StaticResource CancelButtonColor}"
                                       Text="{x:Static loc:LocStrings.Cancel}"
                                       FontSize="16"
                                       Margin="0,0,5,5"
                                       Icon="close"
                                       IconHorizontalPosition="Left"
                                       Clicked="SB_ReminderReport_Cancel_Clicked" />
                    <dxco:SimpleButton x:Name="SB_Save"
                                       Style="{StaticResource PrimaryButton}"
                                       Text="{Binding LocSave}"
                                       FontSize="16"
                                       Margin="0,0,5,5"
                                       IconHorizontalPosition="Left"
                                       Icon="check_second"
                                       Command="{Binding AddReminderCommand}"
                                       Clicked="SB_Save_Clicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </dxco:DXPopup>
    </Grid>
</v:ContentPageBase>
