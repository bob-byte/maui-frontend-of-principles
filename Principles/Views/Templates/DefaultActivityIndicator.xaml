<?xml version="1.0" encoding="utf-8" ?>
<Frame x:Class="Principles.Views.Templates.DefaultActivityIndicator"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:vm="clr-namespace:Principles.ViewModels"
       IsVisible="{Binding IsBusy}"
       WidthRequest="{OnPlatform iOS=60,
                                 Android=70}"
       HeightRequest="{OnPlatform iOS=60,
                                  Android=70}"
       Padding="0"
       x:DataType="vm:BaseViewModel"
       BackgroundColor="{StaticResource LightEditControlBackColor}"
       CornerRadius="{OnPlatform Android=35,
                                 iOS=25}"
       HorizontalOptions="Center"
       VerticalOptions="Center">
    <Frame.Shadow>
        <Shadow Brush="Black"
                Opacity="0.3"
                Radius="12"
                Offset="0,6" />
    </Frame.Shadow>
    <ActivityIndicator WidthRequest="{OnPlatform Android=45}"
                       HeightRequest="{OnPlatform Android=45}"
                       HorizontalOptions="Center"
                       IsRunning="{Binding IsBusy}"
                       VerticalOptions="Center"
                       Color="{StaticResource Primary}" />
</Frame>
