<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase x:Class="Principles.Views.SettingsView"
                   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:dxg="clr-namespace:DevExpress.Maui.DataGrid;assembly=DevExpress.Maui.DataGrid"
                   xmlns:loc="clr-namespace:Principles.Resources.AppStrings"
                   xmlns:m="clr-namespace:Principles.Core.Models;assembly=Principles.Core"
                   xmlns:templates="clr-namespace:Principles.Views.Templates"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:v="clr-namespace:Principles.Views"
                   xmlns:vm="clr-namespace:Principles.ViewModels"
                   Title="{Binding LocManager[Settings]}"
                   x:DataType="vm:SettingsViewModel"
                   Shell.TabBarIsVisible="false">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="15,0,15,0"
                                 MaximumWidthRequest="500"
                                 VerticalOptions="Center">
                <Image Source="logolargesize"
                       WidthRequest="180"
                       HeightRequest="180" />
                <Label Text="{Binding AppName}"
                       FontFamily="CambriaBold"
                       FontSize="40"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <dx:DXButton x:Name="SB_TelegramChannel"
                                   Content="{Binding LocManager[JoinOurTelegram]}"
                                   Command="{Binding ShowTelegramChannelCommand}"
                                   Style="{StaticResource DXPrimaryButton}"
                                   Margin="0,5,0,0" />
                <dx:DXButton x:Name="SB_ContactInfo"
                                   Content="{Binding LocManager[ContactEmail]}"
                                   Command="{Binding OpenEmailCommand}"
                                   Style="{StaticResource DXPrimaryButton}"
                                   Margin="0,15,0,0" />
                <dx:DXButton x:Name="SB_PrivacyPolicy"
                                   Content="{Binding LocManager[PrivacyPolicy]}"
                                   Command="{Binding ShowPrivacyPolicyCommand}"
                                   Style="{StaticResource DXPrimaryButton}"
                                   Margin="0,15,0,0" />
                <dx:DXButton x:Name="SB_UserAgreement"
                                   Content="{Binding LocManager[UserAgreement]}"
                                   Command="{Binding ShowUserAgreementCommand}"
                                   Style="{StaticResource DXPrimaryButton}"
                                   Margin="0,15,0,0" />
                <dx:DXButton x:Name="SB_ChangePassword"
                                   Content="{Binding LocManager[ChangePassword]}"
                                   Command="{Binding ShowChangePasswordCommand}"
                                   Style="{StaticResource DXPrimaryButton}"
                                   Margin="0,10,0,0" />
                <dx:DXButton x:Name="SB_ChangeLanguage"
                                   Content="{Binding LocManager[ChangeLanguage]}"
                                   Clicked="SB_ChangeLanguage_Clicked"
                                   Style="{StaticResource DXPrimaryButton}"
                                   Margin="0,15,0,0" />
                <dx:DXButton x:Name="SB_AppBenefits"
                                   Content="{Binding LocManager[AboutProgram]}"
                                   Command="{Binding ShowAppBenefitsCommand}"
                                   Style="{StaticResource DXPrimaryButton}"
                                   Margin="0,15,0,0" />
                <dx:DXButton x:Name="SB_DeleteAccount"
                                   Content="{Binding LocManager[DeleteAccount]}"
                                   Command="{Binding DeleteAccountCommand}"
                                   Style="{StaticResource DXSecondaryButton}"
                                   Margin="0,15,0,0" />
                <dx:DXButton x:Name="SB_Logout"
                                   Content="{Binding LocManager[Logout]}"
                                   Command="{Binding LogoutCommand}"
                                   Style="{StaticResource DXSecondaryButton}"
                                   Margin="0,15,0,10" />

                <dxco:BottomSheet x:Name="BS_ChangeLanguage"
                                  AllowDismiss="True"
                                  AllowedState="HalfExpanded"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Background},
                                                                    Dark={StaticResource DarkBackground}}"
                                  ShowGrabber="False">
                    <VerticalStackLayout Margin="30,0,30,20"
                                         Spacing="7">

                        <Label x:Name="L_ChooseLanguage"
                               Text="{Binding LocManager[ChooseLanguage]}"
                               Style="{StaticResource CentralHeader}"
                               FontAttributes="Bold"
                               FontSize="22"
                               HorizontalOptions="Center" />

                        <dxe:MultilineEdit x:Name="ME_English"
                                           Text="English"
                                           Style="{StaticResource RoundedMultilineEditStyle}"
                                           Margin="0,10,0,0"
                                           EndIconColor="{StaticResource LabelText}"
                                           Tap="ME_ChooseLanguage_Tap" />
                        <dxe:MultilineEdit x:Name="ME_Ukrainian"
                                           Text="Українська"
                                           Style="{StaticResource RoundedMultilineEditStyle}"
                                           Margin="0,10,0,0"
                                           EndIconColor="{StaticResource LabelText}"
                                           Tap="ME_ChooseLanguage_Tap" />
                        <Grid Margin="0,10,0,0"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="15"
                              HorizontalOptions="FillAndExpand">
                            <dx:DXButton x:Name="SB_ChangeLanguage_Cancel"
                                               Content="{Binding LocManager[Cancel]}"
                                               Clicked="SB_ChangeLanguage_Cancel_Clicked"
                                               Icon="close"
                                               IconPlacement="Left"
                                               BackgroundColor="{StaticResource CancelButtonColor}"
                                               FontSize="16"
                                               Grid.Column="0" />
                            <dx:DXButton x:Name="SB_SaveChangeLanguage"
                                               Content="{Binding LocManager[Save]}"
                                               Clicked="SB_SaveChangeLanguage_Clicked"
                                               Style="{StaticResource PrimaryButton}"
                                               Icon="check_second"
                                               IconPlacement="Left"
                                               FontSize="16"
                                               Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </dxco:BottomSheet>

            </VerticalStackLayout>
        </ScrollView>

        <templates:DefaultActivityIndicator />
    </Grid>
</v:ContentPageBase>