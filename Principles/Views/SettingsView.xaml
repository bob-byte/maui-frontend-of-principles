<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase x:Class="Principles.Views.SettingsView"
                   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:dxg="clr-namespace:DevExpress.Maui.DataGrid;assembly=DevExpress.Maui.DataGrid"
                   xmlns:loc="clr-namespace:Principles.Resources.AppStrings"
                   xmlns:m="clr-namespace:Principles.Core.Models;assembly=Principles.Core"
                   xmlns:templates="clr-namespace:Principles.Views.Templates"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:v="clr-namespace:Principles.Views"
                   xmlns:vm="clr-namespace:Principles.ViewModels"
                   Title="{Binding LocalizationResourceManager[Settings],
                                   Mode=OneWay}"
                   x:DataType="vm:SettingsViewModel">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="15,0,15,0"
                                 VerticalOptions="Center">
                <Image Source="logolargesize"
                       WidthRequest="200"
                       HeightRequest="200" />
                <Label Text="{Binding AppName,
                                      Converter={StaticResource ToUpperCase}}"
                       FontAttributes="Bold"
                       FontFamily="CambriaBold"
                       FontSize="35"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <dxco:SimpleButton x:Name="SB_TelegramChannel"
                                   Text="{Binding LocalizationResourceManager[JoinOurTelegram],
                                                  Mode=OneWay}"
                                   Command="{Binding ShowTelegramChannelCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,5,0,0" />
                <dxco:SimpleButton x:Name="SB_ContactInfo"
                                   Text="{Binding LocalizationResourceManager[ContactEmail],
                                                  Mode=OneWay}"
                                   Command="{Binding OpenEmailCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,15,0,0" />
                <dxco:SimpleButton x:Name="SB_PrivacyPolicy"
                                   Text="{Binding LocalizationResourceManager[PrivacyPolicy],
                                                  Mode=OneWay}"
                                   Command="{Binding ShowPrivacyPolicyCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,15,0,0" />
                <dxco:SimpleButton x:Name="SB_UserAgreement"
                                   Text="{Binding LocalizationResourceManager[UserAgreement],
                                                  Mode=OneWay}"
                                   Command="{Binding ShowUserAgreementCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,15,0,0" />
                <dxco:SimpleButton x:Name="SB_ChangeLanguage"
                                   Text="{Binding LocalizationResourceManager[ChangeLanguage],
                                                  Mode=OneWay}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,15,0,0"
                                   Clicked="SB_ChangeLanguage_Clicked" />
                <dxco:SimpleButton Text="{Binding LocalizationResourceManager[DeleteAccount],
                                                  Mode=OneWay}"
                                   Command="{Binding DeleteAccountCommand}"
                                   Style="{StaticResource SecondaryButton}"
                                   Margin="0,15,0,0" />
                <dxco:SimpleButton Text="{Binding LocalizationResourceManager[Logout],
                                                  Mode=OneWay}"
                                   Command="{Binding LogoutCommand}"
                                   Style="{StaticResource SecondaryButton}"
                                   Margin="0,15,0,0" />

                <dxco:BottomSheet x:Name="BS_ChangeLanguage"
                                  AllowDismiss="True"
                                  AllowedState="HalfExpanded"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Background},
                                                                    Dark={StaticResource DarkBackground}}"
                                  ShowGrabber="False"
                                  HalfExpandedRatio="0.45">
                    <VerticalStackLayout Margin="30,10,30,20"
                                         Spacing="7">

                        <Label Text="{Binding LocalizationResourceManager[ChooseLanguage],
                                              Mode=OneWay}"
                               Style="{StaticResource CentralHeader}"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />

                        <dxe:MultilineEdit x:Name="ME_English"
                                           Text="English"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource RoundedMultilineEditStyle}"
                                           Tap="ME_ChooseLanguage_Tap" />
                        <dxe:MultilineEdit x:Name="ME_Ukrainian"
                                           Text="Українська"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource RoundedMultilineEditStyle}"
                                           Tap="ME_ChooseLanguage_Tap" />
                        <dxe:MultilineEdit x:Name="ME_Russian"
                                           Text="Русский"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource RoundedMultilineEditStyle}"
                                           Tap="ME_ChooseLanguage_Tap" />
                        <Grid Margin="0,10,0,0"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="15"
                              HorizontalOptions="FillAndExpand">
                            <dxco:SimpleButton x:Name="SB_ChangeLanguage_Cancel"
                                               Text="{Binding LocalizationResourceManager[Cancel],
                                                              Mode=OneWay}"
                                               Icon="close"
                                               IconHorizontalPosition="Left"
                                               BackgroundColor="{StaticResource CancelButtonColor}"
                                               FontSize="16"
                                               Grid.Column="0"
                                               Clicked="SB_ChangeLanguage_Cancel_Clicked" />
                            <dxco:SimpleButton x:Name="SB_SaveChangeLanguage"
                                               Text="{Binding LocalizationResourceManager[Save],
                                                              Mode=OneWay}"
                                               Style="{StaticResource PrimaryButton}"
                                               Icon="check_second"
                                               IconHorizontalPosition="Left"
                                               FontSize="16"
                                               Grid.Column="1"
                                               Command="{Binding ChangeLanguageCommand}"
                                               Clicked="SB_SaveChangeLanguage_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </dxco:BottomSheet>

            </VerticalStackLayout>
        </ScrollView>

        <templates:DefaultActivityIndicator />
    </Grid>

</v:ContentPageBase>