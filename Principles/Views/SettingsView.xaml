<?xml version="1.0" encoding="utf-8" ?>
<v:ContentPageBase x:Class="Principles.Views.SettingsView"
                   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
                   xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
                   xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
                   xmlns:dxg="clr-namespace:DevExpress.Maui.DataGrid;assembly=DevExpress.Maui.DataGrid"
                   xmlns:loc="clr-namespace:Principles.Resources.AppStrings"
                   xmlns:m="clr-namespace:Principles.Core.Models;assembly=Principles.Core"
                   xmlns:templates="clr-namespace:Principles.Views.Templates"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   xmlns:v="clr-namespace:Principles.Views"
                   xmlns:vm="clr-namespace:Principles.ViewModels"
                   Title="{Binding Title}"
                   x:DataType="vm:SettingsViewModel">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="15,0,15,0"
                                 VerticalOptions="Center">
                <Image Source="logolargesize"
                       HeightRequest="200"
                       WidthRequest="200" />
                <Label Text="{Binding AppName}"
                       FontFamily="CambriaBold"
                       FontSize="35"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <dxco:SimpleButton x:Name="SB_TelegramChannel"
                                   Text="{x:Static loc:LocStrings.JoinOurTelegram}"
                                   Command="{Binding ShowTelegramChannelCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,5,0,0" />
                <dxco:SimpleButton x:Name="SB_ContactInfo"
                                   Text="{x:Static loc:LocStrings.ContactEmail}"
                                   Command="{Binding OpenEmailCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,15,0,0" />
                <dxco:SimpleButton x:Name="SB_PrivacyPolicy"
                                   Text="{x:Static loc:LocStrings.PrivacyPolicy}"
                                   Command="{Binding ShowPrivacyPolicyCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,15,0,0" />
                <dxco:SimpleButton x:Name="SB_UserAgreement"
                                   Text="{x:Static loc:LocStrings.UserAgreement}"
                                   Command="{Binding ShowUserAgreementCommand}"
                                   Style="{StaticResource PrimaryButton}"
                                   Margin="0,15,0,0" />
                <dxco:SimpleButton Text="{x:Static loc:LocStrings.DeleteAccount}"
                                   Command="{Binding DeleteAccountCommand}"
                                   Style="{StaticResource SecondaryButton}"
                                   Margin="0,15,0,0" />
                <dxco:SimpleButton Text="{x:Static loc:LocStrings.Logout}"
                                   Command="{Binding LogoutCommand}"
                                   Style="{StaticResource SecondaryButton}"
                                   Margin="0,15,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <templates:DefaultActivityIndicator />
    </Grid>
</v:ContentPageBase>