<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		  Keep full multi-targeting for regular builds, but restrict design-time loads
		  (Cursor/C# language server) to Android to avoid transient iOS load failures.
		-->
		<TargetFrameworks Condition="'$(DesignTimeBuild)' == 'true'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(DesignTimeBuild)' != 'true'">net10.0-android;net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Principles</RootNamespace>
		<NeutralLanguage>en</NeutralLanguage>
		<Nullable>disable</Nullable>

		<!-- App Identifier -->
		<ApplicationId>com.set.principles</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>3.2.4</ApplicationDisplayVersion>
		<ApplicationVersion>66</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">21.0</SupportedOSPlatformVersion>
		<ApplicationTitle>Principles</ApplicationTitle>
		<Configurations>Debug;Release;LocalDebug</Configurations>
		<!-- <MauiXamlInflator>SourceGen</MauiXamlInflator>  -->
	</PropertyGroup>

	<PropertyGroup>
		<NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
	</PropertyGroup>

<!--	<PropertyGroup>-->
<!--		<MtouchNoSymbolStrip Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">True</MtouchNoSymbolStrip>-->
<!--	</PropertyGroup>-->

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
		<NoWarn>1701;1702;8632</NoWarn>
		<ArchiveOnBuild>true</ArchiveOnBuild>
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
		<CodesignKey>iPhone Distribution: Bohdan Bats (CHVN5SL89P)</CodesignKey>
		<CodesignProvision>Principles Ad Hoc</CodesignProvision>
		<CreatePackage>false</CreatePackage>
		<BuildIpa>true</BuildIpa>
	</PropertyGroup>

